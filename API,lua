-- Updated New API
local HttpService = game:GetService("HttpService")
local RbxAnalyticsService = game:GetService("RbxAnalyticsService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local HWID = RbxAnalyticsService:GetClientId()

local RAW_URL = "https://raw.githubusercontent.com/iksuwu/ArnarAPI/refs/heads/main/Data.json"

-- リクエスト関数の安全な取得
local request = (syn and syn.request) or (http and http.request) or http_request or request

local AmarAPI = {}
local cache = nil
local lastFetch = 0
local CACHE_TIME = 30 

local function fetchWhitelist()
    if cache and (tick() - lastFetch < CACHE_TIME) then
        return cache
    end

    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(RAW_URL))
    end)

    if not success or type(result) ~= "table" then
        return nil
    end

    cache = result
    lastFetch = tick()
    return result
end

local function kick(reason)
    LocalPlayer:Kick("\n[Amar Premium]\n" .. reason)
end

function AmarAPI.CheckKey(key, callbacks)
    callbacks = callbacks or {}
    local data = fetchWhitelist()

    if not data then
        kick("Whitelist load failed.")
        return
    end

    local keyData = data[key]

    if not keyData then
        -- 安全なコールバック呼び出し
        if callbacks.FailCall then callbacks.FailCall("Invalid Key") end
        kick("Invalid Key")
        return
    end

    if keyData.Blacklist then
        if callbacks.FailCall then callbacks.FailCall("Blacklisted Key") end
        kick("Blacklisted Key")
        return
    end

    -- HWIDが登録されていない場合
    if not keyData.HWID or keyData.HWID == "None" or keyData.HWID == "" then
        if callbacks.SuccCall then callbacks.SuccCall(keyData) end
        return
    end

    -- HWID一致確認
    if keyData.HWID == HWID then
        if callbacks.SuccCall then callbacks.SuccCall(keyData) end
        return
    end

    -- HWID不一致
    if callbacks.FailCall then callbacks.FailCall("HWID Mismatch") end
    kick("HWID mismatch. Reset HWID via Discord Bot.")
end

function AmarAPI.GetHWID(key)
    local data = fetchWhitelist()
    return data and data[key] and data[key].HWID
end

function AmarAPI.GetDiscord(key)
    local data = fetchWhitelist()
    return data and data[key] and data[key].Discord_Name
end

function AmarAPI.IsBlacklisted(key)
    local data = fetchWhitelist()
    return data and data[key] and data[key].Blacklist
end

function AmarAPI.BindHWID(key)
    -- 現在のシステムではBot側で登録するため、ここでは成功を返すのみ
    return true
end

function AmarAPI.Auth(key)
    AmarAPI.CheckKey(key, {
        SuccCall = function(data)
            if not data.HWID or data.HWID == "None" or data.HWID == "" then
                AmarAPI.BindHWID(key)
            end
        end,
        FailCall = function(err)
            warn("Auth Error: " .. tostring(err))
        end
    })
end

return AmarAPI
